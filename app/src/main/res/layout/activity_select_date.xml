<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white"
    tools:context=".ui.user.SelectDateActivity">

    <include
        android:id="@+id/toolbar_select"
        layout="@layout/partial_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

<!--    <include-->
<!--        android:id="@+id/bottom_nav"-->
<!--        layout="@layout/partial_bottom_button"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="wrap_content"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent" />-->

    <com.applandeo.materialcalendarview.CalendarView
        android:id="@+id/calendarview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:abbreviationsBarColor="@color/color_white"
        app:abbreviationsLabelsColor="@color/color_black"
        app:daysLabelsColor="@color/color_black"
        app:todayLabelColor="@color/color_dark_green"
        app:disabledDaysLabelsColor="@color/color_primary"
        app:eventsEnabled="true"
        app:headerColor="@color/color_white"
        app:headerLabelColor="@color/color_black"
        app:highlightedDaysLabelsColor="#FFFF00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_select"
        app:forwardButtonSrc="@drawable/ic_calendar_forward"
        app:previousButtonSrc="@drawable/ic_calendar_previous"
        app:selectionColor="#FF00FF"
        app:selectionLabelColor="@color/color_dark_red" />

    <FrameLayout
        android:id="@+id/date_frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_select" />

</androidx.constraintlayout.widget.ConstraintLayout>