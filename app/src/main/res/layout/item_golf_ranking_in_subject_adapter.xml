<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="subjectTitle"
            type="String" />
        <variable
            name="ranking"
            type="com.artilearn.happygolfgo.ui.home.record.model.RankingBySubjectData"/>
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="114dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="12dp"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        android:outlineProvider="none"
        app:cardCornerRadius="5dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:gravity="start|center_vertical"
                android:layout_height="40dp">
                <View android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/my_golf_ranking_subject_icon1"
                    />
                <TextView
                    android:layout_marginStart="30dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_black"
                    android:text="@{subjectTitle}"
                    tools:text="3월 시험 참여도"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:weightSum="5"
                    android:layout_height="40dp">
                   <View android:layout_width="14dp"
                       android:layout_height="19dp"
                       android:layout_gravity="center"
                       android:layout_marginRight="10dp"
                       android:background="@drawable/my_golf_ranking_subject_medal_first"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:layout_gravity="start|center_vertical"
                        android:paddingLeft="10dp"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="#3F7AA4"
                        android:text="@{ranking.branchName}"
                        tools:text="대구 혁신도시점"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_gravity="center_vertical"
                        android:textAlignment="viewEnd"
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:textColor="#766D6F"
                        android:layout_marginEnd="10dp"
                        android:text="@{ranking.participationRate}"
                        tools:text="-%"
                        tools:ignore="RtlCompat" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="40dp"
                        android:textSize="12dp"
                        android:textColor="#BAAAAE"
                        android:text="@{ranking.sumOfPlayersScoreInfo}"
                        tools:text = ""
                        android:visibility="gone"
                        />
                    <View
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="0dp"
                        android:background="#D9D9D9"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>
</layout>