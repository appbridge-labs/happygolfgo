<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="ranking"
            type="com.artilearn.happygolfgo.ui.home.record.model.RankingInAllBranchData" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="70dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="12dp"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        android:outlineProvider="none"
        app:cardCornerRadius="5dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:gravity="start|center_vertical"
                android:visibility="gone"
                android:layout_height="40dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_black"
                    android:text="역삼점 훈련소"
                    tools:text="역삼점 훈련소"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <!--              div_avg-->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:weightSum="10"
                android:paddingBottom="10dp"
                android:background="@drawable/my_golf_power_exam_result_info_page_normal_background_boarder"
                >
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_weight="3"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:gravity="center"
                    android:layout_height="match_parent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="#3F7AA4"
                        android:text="@{ranking.title}"
                        tools:text="5과목\n평균"
                        />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_weight="7"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:weightSum="3"
                    android:layout_height="match_parent">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:gravity="bottom"
                        android:weightSum="9"
                        android:layout_weight="1"
                        android:layout_height="0dp"
                        >
                        <View
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/my_golf_ranking_all_branch_first_circle"
                            />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:textAlignment="viewEnd"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@{ranking.firstBranchName}"
                            android:textColor="#2671F7"
                            tools:text="김가일*가산디"
                            android:layout_weight="7"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:textSize="20dp"
                            android:textAlignment="viewEnd"
                            android:textColor="#FFA750"
                            android:text="@{ranking.firstBranchScore}"
                            tools:text="100"
                            android:layout_weight="1"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:textSize="10dp"
                            android:textAlignment="viewStart"
                            android:text="점"
                            android:textColor="#4D4D4D"
                            tools:text="점"
                            android:layout_weight="1"
                            />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:weightSum="9"
                        android:gravity="bottom"
                        android:layout_weight="1"
                        android:layout_height="0dp"
                        >
                        <View
                            android:layout_gravity="bottom"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/my_golf_ranking_all_branch_second_circle"
                            />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:textAlignment="viewEnd"
                            android:maxLines="1"
                            android:ellipsize="middle"
                            android:text="@{ranking.secondBranchName}"
                            tools:text="김아무개*"
                            android:textColor="#000000"
                            android:layout_weight="7"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:textSize="20dp"
                            android:textAlignment="viewEnd"
                            android:textColor="#FFA750"
                            android:text="@{ranking.secondBranchScore}"
                            tools:text="100"
                            android:layout_weight="1"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:textSize="10dp"
                            android:textAlignment="viewStart"
                            android:textColor="#4D4D4D"
                            android:text="점"
                            tools:text="점"
                            android:layout_weight="1"
                            />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:weightSum="9"
                        android:gravity="bottom"
                        android:layout_weight="1"
                        android:layout_height="0dp"
                        >
                        <View
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/my_golf_ranking_all_branch_third_circle"
                            />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="20dp"
                            android:textAlignment="viewEnd"
                            android:maxLines="1"
                            android:ellipsize="middle"
                            android:textColor="#000000"
                            android:text="@{ranking.thirdBranchName}"
                            tools:text="김아무개*"
                            android:layout_weight="7"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:textSize="20dp"
                            android:textAlignment="viewEnd"
                            android:text="@{ranking.thirdBranchScore}"
                            android:textColor="#FFA750"
                            tools:text="100"
                            android:layout_weight="1"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="normal"
                            android:textSize="10dp"
                            android:textAlignment="viewStart"
                            android:textColor="#4D4D4D"
                            android:text="점"
                            tools:text="점"
                            android:layout_weight="1"
                            />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>
</layout>